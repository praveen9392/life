# Copy this file to .env for local development (docker compose / uvicorn reload).
ENVIRONMENT=development

# --- Database ---
# Local docker-compose Postgres (see docker-compose.yml). asyncpg driver.
DATABASE_URL=postgresql+asyncpg://life:life@localhost:5432/life_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Required by tests/conftest.py: pytest overrides DATABASE_URL with this
# before importing app code. Point it at a dedicated test database.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:duck@localhost:5432/life_test

# --- Auth / JWT ---
# Generate a strong random value for real deployments, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Cookies / CSRF ---
CSRF_COOKIE_NAME=csrf_token
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
# Leave COOKIE_DOMAIN unset for localhost. cookie_secure=false only makes sense in development over http.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_STORAGE_URI=memory://
# Defaults to true. Set to false only for local E2E runs - register/login are
# rate-limited and will 429 across multi-project Playwright runs otherwise.
RATE_LIMIT_ENABLED=true

# --- Object storage (avatars) ---
# Avatar uploads require an S3-compatible service. docker-compose.yml has no
# MinIO service - run MinIO separately as a local option, or point these at
# any S3-compatible endpoint.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=life-avatars
S3_ACCESS_KEY=life-minio
S3_SECRET_KEY=life-minio-secret
S3_REGION=auto
S3_PUBLIC_BASE_URL=http://localhost:9000/life-avatars

LOG_LEVEL=INFO
# LOG_FILE=/var/log/life/app.log
# LOG_JSON=false
MAX_REQUEST_BODY_BYTES=12582912
