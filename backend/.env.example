# Copy this file to .env for local development (docker compose / uvicorn reload).
ENVIRONMENT=development

# --- Database ---
# Local docker-compose Postgres (see docker-compose.yml). asyncpg driver.
DATABASE_URL=postgresql+asyncpg://life:life@localhost:5432/life_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Auth / JWT ---
# Generate a strong random value for real deployments, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Cookies / CSRF ---
CSRF_COOKIE_NAME=csrf_token
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
# Leave COOKIE_DOMAIN unset for localhost. cookie_secure=false only makes sense in development over http.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_STORAGE_URI=memory://

# --- Object storage (avatars). Local dev points at the docker-compose MinIO service. ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=life-avatars
S3_ACCESS_KEY=life-minio
S3_SECRET_KEY=life-minio-secret
S3_REGION=auto
S3_PUBLIC_BASE_URL=http://localhost:9000/life-avatars

LOG_LEVEL=INFO
